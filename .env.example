# TripVerse Environment Configuration

# Google OAuth Web Client ID (Optional for GIS)
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# Firebase Authentication (Google Sign-In)
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"

# Supabase PostgreSQL Cloud Database & Authentication
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Fast2SMS Gateway (Serverless proxy available via /api/sms)
VITE_FAST2SMS_API_KEY="your-fast2sms-api-key"

# ConCode AI Brain (Kaggle GPU Host / Cloudflare Tunnel / ngrok)
# Can also be dynamically configured inside the TripVerse UI -> AI Co-Pilot settings
CONCODE_API_URL="https://your-kaggle-tunnel.trycloudflare.com"
VITE_CONCODE_API_URL="https://your-kaggle-tunnel.trycloudflare.com"
CONCODE_API_KEY=""
